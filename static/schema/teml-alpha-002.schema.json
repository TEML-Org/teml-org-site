{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teml.org/schema/teml-alpha-002.schema.json",
  "title": "TEML teml.org/v-alpha-002 (compliant documents)",
  "description": "Structural schema for compliant TEML documents, applied after YAML aliases and merge keys are resolved. Sketch documents (no apiVersion) are intentionally looser and are not covered. Semantic rules (reference resolution, etc.) are in spec/teml-alpha-002.md \u00a714.",
  "type": "object",
  "required": [
    "apiVersion",
    "metadata"
  ],
  "properties": {
    "apiVersion": {
      "const": "teml.org/v-alpha-002"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "types": {
      "$ref": "#/$defs/namedList",
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/typeBody"
        }
      }
    },
    "actors": {
      "$ref": "#/$defs/namedList",
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/actorBody"
        }
      }
    },
    "screens": {
      "$ref": "#/$defs/namedList",
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/screenBody"
        }
      }
    },
    "aggs": {
      "$ref": "#/$defs/namedList",
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/props"
        }
      }
    },
    "views": {
      "$ref": "#/$defs/namedList",
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/props"
        }
      }
    },
    "wfes": {
      "$ref": "#/$defs/namedList",
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/wfeBody"
        }
      }
    },
    "systems": {
      "$ref": "#/$defs/namedList",
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/systemBody"
        }
      }
    },
    "slices": {
      "$ref": "#/$defs/namedList",
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/slice"
        }
      }
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "propName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "namedList": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "propertyNames": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "typeExpr": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\[\\])*\\??$"
    },
    "props": {
      "description": "A property map: name -> type expression | one-item list | nested property map. After a view merge (<<), values may also be the marker `x`.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/propName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/propSpec"
      }
    },
    "propSpec": {
      "oneOf": [
        {
          "$ref": "#/$defs/typeExpr"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/propSpec"
          }
        },
        {
          "$ref": "#/$defs/props"
        }
      ]
    },
    "typeBody": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "enum"
          ],
          "properties": {
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/props"
            },
            {
              "not": {
                "required": [
                  "enum"
                ]
              }
            }
          ]
        }
      ]
    },
    "wfeBody": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "aggRef": {
      "description": "A name, or an alias to an aggregate (resolves to its props).",
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "$ref": "#/$defs/props"
        }
      ]
    },
    "viewRef": {
      "description": "A name, an alias to a view, or a merged alias (<<: *View) with `x` markers.",
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "$ref": "#/$defs/props"
        }
      ]
    },
    "wfeRef": {
      "description": "A name, or an alias to a WFE definition.",
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "$ref": "#/$defs/wfeBody"
        }
      ]
    },
    "command": {
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/name"
            },
            "props": {
              "$ref": "#/$defs/props"
            }
          },
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        }
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "name",
        "props"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "props": {
          "$ref": "#/$defs/props"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "screen": {
          "$ref": "#/$defs/screenRef"
        },
        "wfe": {
          "$ref": "#/$defs/wfeRef"
        },
        "system": {
          "$ref": "#/$defs/systemRef"
        }
      },
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/name"
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "name",
        "then"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "given": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instance"
          }
        },
        "when": {
          "$ref": "#/$defs/instance"
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instance"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "actorBody": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "actorRef": {
      "description": "A name, or an alias to an actor.",
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "$ref": "#/$defs/actorBody"
        }
      ]
    },
    "screenBody": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/actorRef"
        },
        "description": {
          "type": "string"
        },
        "wireframe": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "screenRef": {
      "description": "A name, or an alias to a screen.",
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "$ref": "#/$defs/screenBody"
        }
      ]
    },
    "systemBody": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "changeSlice": {
      "type": "object",
      "properties": {
        "agg": {
          "$ref": "#/$defs/aggRef"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/viewRef"
          }
        },
        "wfes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wfeRef"
          }
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "story": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "examples": [
            "Planned",
            "InDev",
            "Completed"
          ]
        },
        "description": {
          "type": "string"
        },
        "specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spec"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "event"
          ]
        },
        {
          "required": [
            "events"
          ]
        }
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false,
      "description": "A change slice: command -> event(s) -> views / WFEs."
    },
    "reader": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "screen": {
          "$ref": "#/$defs/screenRef"
        },
        "wfe": {
          "$ref": "#/$defs/wfeRef"
        }
      },
      "additionalProperties": false
    },
    "viewSlice": {
      "description": "A view slice: where a view is read (screens and/or WFEs).",
      "type": "object",
      "required": [
        "view"
      ],
      "properties": {
        "view": {
          "$ref": "#/$defs/viewRef"
        },
        "readBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reader"
          }
        },
        "story": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "examples": [
            "Planned",
            "InDev",
            "Completed"
          ]
        },
        "description": {
          "type": "string"
        },
        "specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spec"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "slice": {
      "oneOf": [
        {
          "$ref": "#/$defs/changeSlice"
        },
        {
          "$ref": "#/$defs/viewSlice"
        }
      ]
    },
    "systemRef": {
      "description": "A name, or an alias to a system.",
      "oneOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "$ref": "#/$defs/systemBody"
        }
      ]
    }
  }
}
